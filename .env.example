# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- First-run admin (only used when no users exist). Required: there are no default creds.
SIGNAL_ADMIN_EMAIL=admin@example.com
SIGNAL_ADMIN_PASSWORD=change-me-to-a-long-passphrase
SIGNAL_ADMIN_NAME=Administrator

# --- Runtime
SIGNAL_ENV=dev
# Dev (no Docker): SQLite file under backend/data. Compose overrides this to /data.
SIGNAL_DATABASE_URL=sqlite:///./data/signal.db
SIGNAL_SESSION_TTL_HOURS=12

# Secure cookies are only sent over HTTPS (Chrome/Firefox also allow http://localhost;
# Safari does not). Dev mode turns it off and logs a warning. Keep it on anywhere real.
SIGNAL_COOKIE_SECURE=false

# Origin the SPA is served from (CORS allow-list). Dev: Vite. Compose: nginx.
SIGNAL_FRONTEND_ORIGIN=http://localhost:5173

# Limits
SIGNAL_MAX_UPLOAD_BYTES=52428800
SIGNAL_LOGIN_RATE_LIMIT=5/minute
SIGNAL_INGEST_RATE_LIMIT=120/minute
